{
  "name": "kalkulatorbazis-app",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "node scripts/check.mjs",
    "native:add:android": "npx cap add android",
    "native:add:ios": "npx cap add ios",
    "native:sync": "npm run build && npx cap sync",
    "native:android": "npm run build && npx cap sync android && npx cap open android",
    "native:ios": "npm run build && npx cap sync ios && npx cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
