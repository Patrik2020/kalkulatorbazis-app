# local = minden kalkulátor helyben számol
# hybrid = ahol van API-adapter, ott API; hiba esetén helyi fallback
# api = ahol van API-adapter, ott szigorúan API; adapter nélküli kalkulátor helyben marad
VITE_CALCULATION_MODE=local
VITE_API_BASE_URL=https://api.kalkulatorbazis.hu
VITE_API_TIMEOUT_MS=8000
